{
  "manifest_version": 3,
  "name": "Tab Zero",
  "version": "0.3.0",
  "description": "Read your open YouTube tabs as text: collect every transcript into one Markdown file.",
  "permissions": ["tabs", "scripting", "downloads", "storage", "unlimitedStorage"],
  "host_permissions": ["https://www.youtube.com/*", "https://sponsor.ajay.app/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Tab Zero: read your YouTube tabs",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  }
}
